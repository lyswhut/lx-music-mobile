{
  "name": "lx-music-mobile",
  "version": "1.8.4",
  "versionCode": 76,
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-oh-autolinking.mjs",
    "dev": "react-native run-android --active-arch-only",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "sc": "react-native start --reset-cache",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "rd": "react-devtools",
    "menu": "adb shell input keyevent 82",
    "bundle-android": "react-native bundle --platform android --dev true --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "build-test": "react-native bundle --platform android --dev true --entry-file index.js --bundle-output index.android.bundle --assets-dest res",
    "bundle-harmony": "node scripts/prepare-harmony-assets.mjs && react-native bundle-harmony --dev true --entry-file index.harmony.js",
    "bundle-harmony:probe": "npm run bundle-harmony",
    "bundle-harmony:smoke": "node scripts/prepare-harmony-assets.mjs && react-native bundle-harmony --dev true --entry-file index.harmony.smoke.js",
    "bundle-harmony:player-smoke": "node scripts/prepare-harmony-assets.mjs && react-native bundle-harmony --dev true --entry-file index.harmony.player-smoke.js",
    "bundle-harmony:crypto-smoke": "node scripts/prepare-harmony-assets.mjs && node scripts/prepare-harmony-crypto-probe.mjs && react-native bundle-harmony --dev true --entry-file index.harmony.crypto-smoke.js",
    "bundle-harmony:release": "node scripts/prepare-harmony-assets.mjs && react-native bundle-harmony --dev false --entry-file index.harmony.js",
    "pack:android:debug": "./gradlew assembleDebug",
    "pack": "npm run pack:android",
    "pack:android": "cd android && gradlew.bat assembleRelease",
    "clear": "cd android && gradlew.bat clean",
    "clear:full": "git clean -fdx -e android/keystore.properties -e android/app/*.keystore",
    "build:theme": "node src/theme/themes/createThemes.js",
    "publish": "node publish"
  },
  "engines": {
    "node": ">= 18",
    "npm": ">= 8.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyswhut/lx-music-mobile.git"
  },
  "keywords": [
    "music-player",
    "react-native-app"
  ],
  "author": {
    "name": "lyswhut",
    "email": "lyswhut@qq.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/lyswhut/lx-music-mobile/issues"
  },
  "homepage": "https://github.com/lyswhut/lx-music-mobile#readme",
  "dependencies": {
    "@craftzdog/react-native-buffer": "^6.1.1",
    "@react-native-async-storage/async-storage": "npm:@react-native-oh-tpl/async-storage@1.21.0-0.2.2",
    "@react-native-clipboard/clipboard": "npm:@react-native-oh-tpl/clipboard@1.13.2-0.0.9",
    "@react-native-community/slider": "npm:@react-native-oh-tpl/slider@4.4.3-0.3.4",
    "@react-native-oh/react-native-harmony": "0.72.144",
    "@react-native-oh-tpl/react-native-screens": "3.34.0-rc.6",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "he": "^1.2.0",
    "iconv-lite": "^0.7.2",
    "lrc-file-parser": "^2.4.1",
    "message2call": "^0.1.3",
    "pako": "^2.1.0",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "react-native-background-timer": "file:./vendor/react-native-background-timer",
    "react-native-exception-handler": "npm:@react-native-oh-tpl/react-native-exception-handler@2.10.10-0.1.7",
    "react-native-file-system": "file:./vendor/react-native-file-system",
    "react-native-fs": "npm:@react-native-oh-tpl/react-native-fs@2.20.0-0.1.14",
    "react-native-local-media-metadata": "file:./vendor/react-native-local-media-metadata",
    "react-native-pager-view": "npm:@react-native-oh-tpl/react-native-pager-view@6.2.3-0.2.8",
    "react-native-quick-base64": "npm:@react-native-oh-tpl/react-native-quick-base64@2.1.2-1.0.1",
    "react-native-quick-md5": "^3.0.9",
    "react-native-safe-area-context": "npm:@react-native-oh-tpl/react-native-safe-area-context@4.7.4-0.2.1",
    "react-native-screens": "file:./vendor/react-native-screens",
    "react-native-track-player": "file:./vendor/react-native-track-player",
    "react-native-vector-icons": "10.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/preset-env": "^7.29.2",
    "@babel/runtime": "^7.29.2",
    "@react-native/metro-config": "^0.72.12",
    "@tsconfig/react-native": "^3.0.9",
    "@types/he": "^1.2.3",
    "@types/react": "^18.3.27",
    "@types/react-native": "^0.72.8",
    "@types/react-native-background-timer": "^2.0.2",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "changelog-parser": "^3.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "metro-react-native-babel-preset": "^0.76.8",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@craftzdog/react-native-buffer": {
      "react-native-quick-base64": "$react-native-quick-base64"
    },
    "@react-native-community/cli-platform-android": {
      "fast-xml-parser": "^5.3.4"
    },
    "@react-native-community/cli-platform-ios": {
      "fast-xml-parser": "^5.3.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9"
    }
  }
}
