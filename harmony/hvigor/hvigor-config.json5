{
  "modelVersion": "6.1.0",
  "dependencies": {
    // RNOH 的 hvigor 插件（随 @react-native-oh/react-native-harmony 附带的 tgz），
    // 提供 createRNOHProjectPlugin / createRNOHModulePlugin（autolinking + codegen）。
    // 注意：hvigor-config.json5 在 harmony/hvigor/ 下，file: 相对它解析，
